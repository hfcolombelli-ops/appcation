APP_NAME=Appcation
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Versão em GET /api/health (CI pode injetar git SHA ou tag).
# APP_VERSION=1.0.0

# URL base para o QR e GET /certificates/verify/{code} (por defeito = APP_URL).
# CERTIFICATE_VERIFY_BASE_URL=https://api-xxxx.up.railway.app

# Lembretes de recertificação (artisan certificates:send-recertification-reminders, agendado às 08:40).
# RECERTIFICATION_REMINDERS_ENABLED=true
# RECERTIFICATION_REMINDER_DAYS=30,7

# Reavaliações pós-treino (dias após conclusão; vazio = só se metadata.follow_up.days no treino).
# FOLLOW_UP_DEFAULT_DAYS=10,15,30

# Digesto semanal por e-mail (gestor + fabricante): artisan reports:send-weekly-dashboard-digests
# Agendado às segundas 07:00 em routes/console.php. URL da app Web no corpo do e-mail:
# FRONTEND_APP_URL=https://appcation.web.app
# DASHBOARD_DIGEST_ENABLED=true
# Opt-out por utilizador: coluna users.weekly_dashboard_digest + PATCH /api/me/notification-preferences

# Railway / produção: URL pública do backend e do Flutter (Firebase Hosting ou Railway).
# APP_URL=https://api-xxxx.up.railway.app
#
# CORS: origens do Flutter Web no Firebase + dev local (localhost/127.0.0.1 qualquer porta via patterns em config/cors.php).
# Para outros domínios, acrescente aqui separado por vírgula.

# Postgres no Railway: adiciona o plugin PostgreSQL e define, por exemplo:
# DB_CONNECTION=pgsql
# DB_URL="${DATABASE_URL}"
# (No dashboard Railway podes mapear DATABASE_URL → DB_URL numa variável referenciada.)

CORS_ALLOWED_ORIGINS=https://appcation.web.app,https://appcation.firebaseapp.com
CORS_SUPPORTS_CREDENTIALS=false

# Google Sign-In (OAuth Client ID tipo Web — mesmo valor no Flutter e aqui)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Broadcast: `null` ou `log` em dev; `reverb` com `php artisan reverb:start` (ver laravel.com/docs/reverb).
# O Flutter Web lê GET /api/realtime/client-config e subscreve `training.{id}` (fallback: polling 2s/4s).
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
#
# Host público para WebSocket no browser (Flutter). Se vazio, usa REVERB_HOST.
# Ex.: proxy em api.dominio.com e Reverb em wss no mesmo host ou subdomínio.
# REVERB_CLIENT_HOST=

# Revisores Fluxxo: e-mails (contas registadas) que podem PATCH /api/manufacturer/reviews/{id}
# e recebem e-mail quando um fabricante submete validação (MAIL_* configurado).
# MANUFACTURER_REVIEWER_EMAILS=revisor1@dominio.com,revisor2@dominio.com
# E-mail opcional aos revisores quando uma conta fabricante é criada (antes do pedido de validação).
# MANUFACTURER_NOTIFY_ON_REGISTRATION=false

# LGPD / privacidade (opcional — ver config/lgpd.php)
# LGPD_PRIVACY_POLICY_VERSION=v1.0_20260502
# DPO_EMAIL=privacidade@seudominio.com
# DPO_PHONE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Disco por defeito da app (uploads fabricante, etc.). Para S3: `s3` + preencher AWS_* abaixo.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
