# Copia para dart_defines.production.env (gitignored) e preenche os valores.
# Login com e-mail e palavra-passe na Web funciona sem Firebase. As chaves FIREBASE_WEB_*
# são necessárias sobretudo para «Entrar com Google» na Web (e opcionalmente Analytics).
# Firebase Console → Definições do projeto → As tuas apps → Web.
# Se não existir app Web: "Adicionar app" → Web → regista (ex.: nome "Appcation Web").
# Depois copia o objeto firebaseConfig (apiKey, appId, etc.).
#
# O script ./scripts/deploy_web_hosting.sh usa este ficheiro quando existe.

API_BASE_URL=https://appcation-production.up.railway.app

# OAuth Client ID tipo **Web** (Google Cloud Console → APIs & Services → Credentials).
# Tem de ser o mesmo valor que GOOGLE_CLIENT_ID no Laravel (.env Railway).
# Origens autorizadas: https://appcation.web.app (e localhost para dev).
GOOGLE_WEB_CLIENT_ID=

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_PROJECT_ID=appcation
FIREBASE_WEB_AUTH_DOMAIN=appcation.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=appcation.firebasestorage.app
FIREBASE_WEB_MEASUREMENT_ID=
