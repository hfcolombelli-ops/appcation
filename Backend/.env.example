APP_NAME=Appcation
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Railway / produção: URL pública do backend e do Flutter (Firebase Hosting ou Railway).
# APP_URL=https://api-xxxx.up.railway.app
#
# CORS: origens do Flutter Web no Firebase + dev local (localhost/127.0.0.1 qualquer porta via patterns em config/cors.php).
# Para outros domínios, acrescente aqui separado por vírgula.

# Postgres no Railway: adiciona o plugin PostgreSQL e define, por exemplo:
# DB_CONNECTION=pgsql
# DB_URL="${DATABASE_URL}"
# (No dashboard Railway podes mapear DATABASE_URL → DB_URL numa variável referenciada.)

CORS_ALLOWED_ORIGINS=https://appcation.web.app,https://appcation.firebaseapp.com
CORS_SUPPORTS_CREDENTIALS=false

# Google Sign-In (OAuth Client ID tipo Web — mesmo valor no Flutter e aqui)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Broadcast em tempo real (log em dev; use reverb em produção com Reverb a correr)
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# LGPD / privacidade (opcional — ver config/lgpd.php)
# LGPD_PRIVACY_POLICY_VERSION=v1.0_20260502
# DPO_EMAIL=privacidade@seudominio.com
# DPO_PHONE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
